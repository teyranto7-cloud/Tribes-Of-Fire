extends SceneTree
const Inventory = preload("res://Core/Inventory.gd")
const Exchange = preload("res://Trading/Exchange.gd")
const Pings = preload("res://Communication/TeamPings.gd")
const Tribes = preload("res://Tribes/System.gd")
const Channels = preload("res://Communication/Channels.gd")
const Grid = preload("res://Energy/Grid.gd")
const Session = preload("res://Networking/Session.gd")
var checks := 0
var failed := 0
var game
func check(ok: bool, text: String) -> void:
	checks += 1
	if not ok: failed += 1; push_error(text)
func _initialize() -> void: call_deferred("run")
func exchange_tests() -> void:
	var trades := Exchange.new(); var a := Inventory.new(); var b := Inventory.new()
	a.add("wood", 8); b.add("stone", 5)
	check(not trades.create("a", "a", "wood", 1, "stone", 1, a, 1000), "Self trade refused")
	check(not trades.create("a", "b", "wood", 9, "stone", 1, a, 1000), "Insufficient offer refused")
	check(trades.create("a", "b", "wood", 4, "stone", 2, a, 1000), "Immutable offer created")
	var uid: String = trades.offers.keys()[0]
	check(a.count("wood") == 8 and b.count("stone") == 5, "Offer reserves no unpersisted escrow")
	check(trades.visible("enemy").is_empty() and trades.visible("b").size() == 1, "Only participants see offer")
	check(not trades.accept("enemy", uid, a, b, 1001), "Third party cannot accept")
	check(trades.accept("b", uid, a, b, 1001), "Both consenting inventories exchange atomically")
	check(a.count("wood") == 4 and a.count("stone") == 2 and b.count("wood") == 4 and b.count("stone") == 3, "Exact conservation")
	check(not trades.accept("b", uid, a, b, 1002), "Acceptance replay cannot duplicate items")
	a.add("iron_pickaxe", 1, 23)
	check(trades.create("a", "b", "iron_pickaxe", 1, "stone", 1, a, 1003), "Worn tool offered")
	uid = trades.offers.keys()[0]; check(trades.accept("b", uid, a, b, 1004) and b.durability["iron_pickaxe"] == 23, "Trade preserves tool wear")
	var full := Inventory.new(); var state := full.serialize()
	for i in range(36): state["slots"][i] = {"id": "stone", "count": 99}
	state["equipment"]["hand"] = ""; full.restore(state)
	trades.create("a", "full", "wood", 1, "stone", 1, a, 1005)
	uid = trades.offers.keys()[0]
	var before_a := a.serialize(); var before_b := full.serialize()
	check(not trades.accept("full", uid, a, full, 1006), "Full receiver prevents exchange")
	check(a.serialize() == before_a and full.serialize() == before_b, "Failed exchange changes neither backpack")
	trades.expire(["a", "full"], 1096)
	check(trades.offers.is_empty() and a.serialize() == before_a, "Expired offers lose no items")
	trades.create("a", "b", "wood", 1, "stone", 1, a, 1100); trades.expire(["a"], 1101)
	check(trades.offers.is_empty(), "Disconnected offers close without escrow loss")
func social_tests() -> void:
	var tribes := Tribes.new(); var channels := Channels.new(); var pings := Pings.new()
	for person in ["a", "b", "enemy"]: tribes.command(person, "tribe_create", {"name": "Tribe " + person}, 1000)
	var ta: String = tribes.tribe_of("a"); var tb: String = tribes.tribe_of("b")
	tribes.command("a", "tribe_alliance", {"target": tb}, 1001); tribes.command("b", "tribe_accept_alliance", {"target": ta}, 1002)
	var positions := {"a": Vector3.ZERO, "b": Vector3(2, 0, 0), "enemy": Vector3(3, 0, 0)}
	var recipients: Array = channels.recipients("a", "allies", "", positions, tribes)
	check("a" in recipients and "b" in recipients and "enemy" not in recipients, "Allies channel excludes enemies")
	var profile := {"cells": {"0,0": true, "20,20": true}}
	check(pings.create("a", Vector2(2, 2), Vector3.ZERO, profile, tribes, 1000), "Ping created at discovered nearby position")
	check(pings.visible("b", tribes).size() == 1 and pings.visible("enemy", tribes).is_empty(), "Ping only reaches tribe and allies")
	check(pings.visible("b", tribes, {"b": ["a"]}).is_empty(), "Block suppresses pings")
	check(not pings.create("a", Vector2(2, 2), Vector3.ZERO, profile, tribes, 1001), "Ping cooldown enforced")
	check(not pings.create("a", Vector2(400, 400), Vector3.ZERO, profile, tribes, 1003), "Distant ping refused even in discovered cell")
	check(not pings.create("a", Vector2(40, 40), Vector3.ZERO, profile, tribes, 1003), "Secret undiscovered terrain cannot be pinged")
	tribes.command("a", "tribe_break_alliance", {"target": tb}, 1004)
	check(pings.visible("b", tribes).is_empty() and channels.recipients("a", "allies", "", positions, tribes) == ["a"], "Ending alliance immediately revokes social visibility")
	pings.advance(20, positions.keys()); check(pings.entries.is_empty(), "Server expires ping after 20 seconds")
func run() -> void:
	exchange_tests(); social_tests()
	for entry in [["team_ping", {"position": [2, 2]}], ["trade_offer", {"target": "b", "give": "wood", "amount": 1, "want": "stone", "quantity": 1}], ["energy_connect", {"a": "n1", "b": "w0"}], ["energy_install", {"station": 0}]]:
		check(Session.valid_command(entry[0], entry[1]), "Protocol accepts " + entry[0])
	check(not Session.valid_command("energy_connect", {"a": "n1", "b": "n1"}), "Protocol rejects cable self loop")
	check(not Session.valid_command("trade_offer", {"target": "b", "give": "wood", "amount": -1, "want": "stone", "quantity": 1}), "Protocol rejects negative trade")
	game = load("res://Scenes/Main.tscn").instantiate(); game.save_folder = "user://settlement/%d" % Time.get_ticks_usec(); root.add_child(game)
	while not game.ready_world: await process_frame
	game.new_game(718991); game.set_process(false); game.set_physics_process(false); game.player.set_physics_process(false)
	game.runtime.command(1, "appearance", preload("res://Character/Appearance.gd").DEFAULT.duplicate(true))
	game.player.position=Vector3(0,game.world.terrain_height(0,0)+0.2,0);game.player.rotation.y=0
	var free_site:Dictionary=Grid.placement(game.world,game.player,"power_pole")
	check(free_site["valid"],"Pole preview accepts clear ground")
	var obstacle:=StaticBody3D.new();game.world.add_child(obstacle);obstacle.position=free_site["position"]
	var block:=BoxShape3D.new();block.size=Vector3(1,3,1);preload("res://World/Shapes.gd").collider(obstacle,block,Vector3.UP*1.5)
	await physics_frame;await physics_frame
	check(not Grid.placement(game.world,game.player,"power_pole")["valid"],"Power devices reject physical overlap with existing objects")
	obstacle.queue_free();await physics_frame
	var grid = game.runtime.grid; var owner: String = game.runtime.key(1)
	var river = game.world.sampler.watershed
	var wheel := Vector3(river.center(50), game.world.water_level + 1, 50)
	check(Grid.wheel_current(game.world, wheel) > 0, "Seed river has usable flow")
	check(Grid.wheel_current(game.world, Vector3.ZERO) == 0, "Dry ground cannot generate power")
	var crossing := Vector3(river.center(180), game.world.water_level + 1, 180)
	check(Grid.wheel_current(game.world, crossing) == 0, "Shallow crossing cannot power a wheel")
	var bank := Vector3(wheel.x + river.width(50) + 4, 0, 50); bank.y = game.world.terrain_height(bank.x, bank.z)
	var source: String = grid.add("waterwheel", wheel, owner)
	var lamp: String = grid.add("electric_lamp", bank, owner)
	game.inventory.add("wire", 50)
	check(grid.link_ports(source, lamp, owner, game.inventory, game.world, game.runtime.workshops, game.runtime.tribes), "Wire connects wheel to bank lamp with a real cost")
	var wire_count: int = game.inventory.count("wire")
	check(not grid.link_ports(source, lamp, owner, game.inventory, game.world, game.runtime.workshops, game.runtime.tribes) and game.inventory.count("wire") == wire_count, "Duplicate cable cannot charge again")
	grid.evaluate(game.world, game.runtime.workshops, game.runtime.tribes)
	check(grid.powered.get(lamp, false), "Flowing wheel powers real lamp demand")
	grid.nodes[source]["enabled"] = false; grid.evaluate(game.world, game.runtime.workshops, game.runtime.tribes)
	check(not grid.powered.get(lamp, true), "Switched-off generator supplies nothing")
	grid.nodes[source]["enabled"] = true
	game.runtime._add_workshop("sawmill", bank + Vector3(0, 0, 4), owner)
	grid.motors.append(0)
	check(grid.link_ports(lamp, "w0", owner, game.inventory, game.world, game.runtime.workshops, game.runtime.tribes), "Wired motor joins component")
	grid.evaluate(game.world, game.runtime.workshops, game.runtime.tribes)
	check(grid.powered.get("w0", false), "Generator satisfies motor demand")
	check(not grid.link_ports(source, "w0", "intruder", game.inventory, game.world, game.runtime.workshops, game.runtime.tribes), "Unauthorized player cannot tap grid")
	var machine = game.runtime.workshops[0]; machine.machine["recipe"] = "sawmill_planks"; machine.machine["input"] = {"log": 2}
	grid.nodes[source]["enabled"] = false; game.runtime._energy_left = 0; game.runtime._activities_usec = Time.get_ticks_usec() - 8000000; game.runtime.tick(0.1)
	check(machine.machine["output"].is_empty(), "Motorized factory pauses without power and preserves inputs")
	grid.nodes[source]["enabled"] = true; game.runtime._energy_left = 0; game.runtime._activities_usec = Time.get_ticks_usec() - 5000000; game.runtime.tick(0.1)
	check(int(machine.machine["output"].get("plank", 0)) == 6, "Powered factory completes production at upgraded speed")
	game.runtime._add_workshop("carpenter", bank+Vector3(0,0,8), owner)
	var target=game.runtime.workshops[1];target.machine["recipe"]="wall_kit";target.machine["input"]={"rope":4}
	game.inventory.add("conveyor",1)
	check(game.runtime.automation.add(0,1,"plank",owner,game.inventory,game.runtime.workshops,game.runtime.tribes),"Conveyor installation costs an item and accepts compatible recipe")
	check(not game.runtime.automation.add(0,1,"plank",owner,game.inventory,game.runtime.workshops,game.runtime.tribes),"Duplicate belt cannot consume another kit")
	game.runtime.automation.advance(0.99,game.runtime.workshops,grid,game.runtime.tribes)
	check(target.machine["input"].get("plank",0)==0,"No conveyor transfer before one second")
	game.runtime.automation.advance(0.01,game.runtime.workshops,grid,game.runtime.tribes)
	check(target.machine["input"].get("plank",0)==1 and machine.machine["output"]["plank"]==5,"Belt transfers one item without duplication")
	grid.nodes[source]["enabled"]=false;grid.evaluate(game.world,game.runtime.workshops,game.runtime.tribes)
	game.runtime.automation.advance(3,game.runtime.workshops,grid,game.runtime.tribes)
	check(target.machine["input"]["plank"]==1,"Unpowered conveyor pauses without moving escrow")
	grid.nodes[source]["enabled"]=true;grid.evaluate(game.world,game.runtime.workshops,game.runtime.tribes)
	game.runtime.automation.advance(5,game.runtime.workshops,grid,game.runtime.tribes)
	preload("res://Building/Factory.gd").advance(target.machine,target.kind,20)
	check(target.machine["output"].get("wall_kit",0)==1 and target.machine["input"]["plank"]==2 and machine.machine["output"]["plank"]==0,"Automated sawmill to carpenter produces a usable wall kit and preserves two spare planks")
	check(preload("res://Building/Automation.gd").valid(game.runtime.automation.routes,2),"Belt timer and endpoints are saveable")
	for i in range(2, 6):
		game.runtime._add_workshop("sawmill", bank + Vector3(i, 0, 4), owner); grid.motors.append(i)
		grid.links.append({"a": lamp, "b": "w%d" % i, "owner": owner, "wire": 1})
	grid.evaluate(game.world, game.runtime.workshops, game.runtime.tribes)
	check(not grid.powered.get(lamp, true) and grid.meters[lamp]["overload"], "Demand above generation trips whole component")
	check(Grid.valid(grid.state(), game.world.half_extent(), game.runtime.workshops.size()), "Grid save schema accepts complete graph")
	var snapshot: Dictionary = game.snapshot()
	check(preload("res://Persistence/Store.gd").valid(snapshot), "Entire world snapshot remains compatible")
	check(game.save_game(), "Save grid to disk")
	var loaded := preload("res://Persistence/Store.gd").load_world(game.save_folder)
	var expected: Dictionary = grid.state()
	game.runtime.restore(loaded)
	check(game.runtime.automation.routes.size()==1 and int(game.runtime.automation.routes[0]["to"])==1,"Reload preserves automatic factory route")
	check(grid.state() == expected, "Reload preserves wheel, motor, wire and switches")
	var corrupt: Dictionary = grid.state(); corrupt["links"].append(corrupt["links"][0].duplicate())
	check(not Grid.valid(corrupt, 768, game.runtime.workshops.size()), "Duplicate persisted cable is rejected")
	var legacy: Dictionary = snapshot.duplicate(true); legacy.erase("energy_grid")
	check(preload("res://Persistence/Store.gd").valid(legacy), "Pre-energy saves still load")
	print("SETTLEMENT CHECKS=%d FAILED=%d" % [checks, failed])
	await game.quit_game(0 if failed == 0 else 1, false)
